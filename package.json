{
  "name": "luma-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \".storybook/**/*.ts\" \"*.{json,mjs,ts}\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \".storybook/**/*.ts\" \"*.{json,mjs,ts}\" README.md",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5"
  }
}
